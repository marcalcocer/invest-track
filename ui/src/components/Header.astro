---
import PrivacyToggle from "./PrivacyToggle";
import ThemeToggle from "./ThemeToggle";

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const isHome = currentPath === base || currentPath === base.slice(0, -1);
const isAbout = currentPath === `${base}about` || currentPath === `${base}about/`;

const linkBase = "block rounded-md px-3 py-2 transition-colors";
const linkActive = "bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900";
const linkInactive =
  "bg-slate-100 text-slate-900 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700";
const homeClass = `${linkBase} ${isHome ? linkActive : linkInactive}`;
const aboutClass = `${linkBase} ${isAbout ? linkActive : linkInactive}`;
---

<nav class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-700">
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
    <!-- Logo Section -->
    <div class="flex items-center space-x-3 rtl:space-x-reverse">
      <a href={base} class="flex items-center space-x-2">
        <img src={`${base}logo.svg`} class="h-8" />
        <span class="self-center text-2xl font-semibold whitespace-nowrap text-slate-900 dark:text-white">InvestTrack</span>
      </a>
    </div>

    <!-- Right-aligned Desktop Nav, Privacy Toggle and Theme Toggle -->
    <div class="hidden w-full md:flex md:w-auto md:items-center space-x-3 rtl:space-x-reverse">
      <PrivacyToggle client:load />
      <ThemeToggle client:load />
      <ul class="font-medium flex flex-col p-4 md:p-0 mt-4 md:mt-0 md:flex-row md:space-x-3 rtl:space-x-reverse">
        <li>
          <a href={base} class={homeClass} aria-current={isHome ? "page" : undefined}>Home</a>
        </li>
        <li>
          <a href={`${base}about`} class={aboutClass} aria-current={isAbout ? "page" : undefined}>About</a>
        </li>
      </ul>
    </div>

    <!-- Mobile Menu Button, Privacy Toggle and Theme Toggle -->
    <div class="flex items-center md:hidden space-x-3 rtl:space-x-reverse">
      <PrivacyToggle client:load />
      <ThemeToggle client:load />
      <button
        data-collapse-toggle="navbar-default"
        type="button"
        class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
        aria-controls="navbar-default"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation Links (collapsible) -->
    <div class="hidden w-full md:hidden" id="navbar-default">
      <ul class="font-medium flex flex-col gap-2 p-4 mt-4 border border-gray-100 rounded-lg bg-gray-50 dark:bg-slate-800 dark:border-slate-700">
        <li>
          <a href={base} class={homeClass} aria-current={isHome ? "page" : undefined}>Home</a>
        </li>
        <li>
          <a href={`${base}about`} class={aboutClass} aria-current={isAbout ? "page" : undefined}>About</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
  // Hamburger menu functionality
  document.addEventListener('DOMContentLoaded', function() {
    const hamburgerButton = document.querySelector('[data-collapse-toggle="navbar-default"]');
    const navbar = document.getElementById('navbar-default');

    if (hamburgerButton && navbar) {
      hamburgerButton.addEventListener('click', function() {
        navbar.classList.toggle('hidden');
      });
    }
  });
</script>
